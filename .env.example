# Für Produktion zwingend durch einen langen, zufälligen Wert ersetzen.
APP_SECRET=change-me-use-at-least-32-random-characters

# Optional: Standard ist 3001.
PORT=3001

# Optional für Docker: Port, unter dem der Planer im Heimnetz erreichbar ist.
HOST_PORT=3001

# Empfohlen bei öffentlichem Zugriff: Adresse ohne abschließenden Pfad.
# So zeigt der App-QR-Code auch in lokalen Vorschauen auf den echten Server.
# PUBLIC_APP_URL=https://familie.example.de

# Zeitzone für Kalender und Erinnerungen.
TZ=Europe/Berlin

# Empfohlen: automatisch nur bei HTTPS setzen.
# SESSION_COOKIE_SECURE=auto

# Optional: Speicherorte für Datenbank und Altimport.
# DATABASE_FILE=./family_planner.sqlite
# LEGACY_DATABASE_FILE=./family_db.json

# Externe ICS-Kalender werden standardmäßig einmal pro Stunde aktualisiert.
# CALENDAR_SYNC_INTERVAL_MINUTES=60

# Terminerinnerungen werden standardmäßig alle 30 Sekunden geprüft.
# EVENT_REMINDER_INTERVAL_SECONDS=30

# Native Android-Benachrichtigungen (Firebase Cloud Messaging).
# Der private Dienstschlüssel liegt standardmäßig in
# data/firebase-service-account.json und wird niemals in Git aufgenommen.
# Alternativ kann ein abweichender Pfad angegeben werden:
# FIREBASE_SERVICE_ACCOUNT_FILE=./data/firebase-service-account.json
# FIREBASE_PROJECT_ID=lx-family-example

# Optional: Nextcloud zusammen mit LX Family starten.
# Am einfachsten "Nextcloud-Aktivieren.cmd" (Windows) oder
# "./scripts/nextcloud-enable.sh" (Linux/PVE) ausführen. Das Hilfsskript
# erzeugt alle Kennwörter zufällig und aktiviert das Docker-Profil.
# Danach richtet die Elternzentrale automatisch ein getrenntes Cloud-Konto
# pro Familie ein; die Admin-Zugangsdaten bleiben ausschließlich serverseitig.
# COMPOSE_PROFILES=nextcloud
# NEXTCLOUD_PORT=8080
# Adresse, die Familiengeräte im Browser wirklich erreichen können.
# Heimnetz: http://192.168.178.50:8080
# Öffentlich nach eingerichteter Proxy-Route: https://cloud.example.de
# NEXTCLOUD_PUBLIC_URL=http://192.168.178.50:8080
# Auf Linux/PVE anschließend sicher anwenden mit:
# ./scripts/nextcloud-public-url.sh https://cloud.example.de
# NEXTCLOUD_ADMIN_USER=familyadmin
# NEXTCLOUD_ADMIN_PASSWORD=
# NEXTCLOUD_DB_PASSWORD=
# NEXTCLOUD_DB_ROOT_PASSWORD=
# NEXTCLOUD_REDIS_PASSWORD=
# NEXTCLOUD_TRUSTED_DOMAINS=localhost nextcloud 192.168.178.50

# Family-Cloud-Kalender werden standardmäßig alle 15 Minuten geprüft.
# Lokale Änderungen werden zusätzlich nach wenigen Sekunden übertragen.
# NEXTCLOUD_SYNC_INTERVAL_MINUTES=15

# Zusätzliche Ursprünge für die native App oder eine getrennt gehostete UI.
# Kommagetrennt und nur vertrauenswürdige Adressen eintragen.
# CORS_ALLOWED_ORIGINS=https://familie.example.de,http://192.168.178.50:3001

# Nur einschalten, wenn Kalenderlinks bewusst auf ein Gerät im eigenen
# Heimnetz zeigen, zum Beispiel auf einen lokalen Nextcloud-Server.
# CALENDAR_ALLOW_PRIVATE_HOSTS=true

# Optional: Agent-API aktivieren. Ohne Schlüssel bleibt sie gesperrt.
# AGENT_API_KEY=change-me-separate-random-api-key

# Optional: feste Web-Push-Schlüssel für mehrere Serverinstanzen.
# Ohne diese Werte erzeugt der Planer einmalig eigene Schlüssel und speichert
# sie verschlüsselt in der SQLite-Datenbank.
# VAPID_SUBJECT=mailto:family-planner@example.de
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
