# Für Produktion zwingend durch einen langen, zufälligen Wert ersetzen.
APP_SECRET=change-me-use-at-least-32-random-characters

# Optional: Standard ist 3001.
PORT=3001

# Optional für Docker: Port, unter dem der Planer im Heimnetz erreichbar ist.
HOST_PORT=3001

# Zeitzone für Kalender und Erinnerungen.
TZ=Europe/Berlin

# Empfohlen: automatisch nur bei HTTPS setzen.
# SESSION_COOKIE_SECURE=auto

# Optional: Speicherorte für Datenbank und Altimport.
# DATABASE_FILE=./family_planner.sqlite
# LEGACY_DATABASE_FILE=./family_db.json

# Externe ICS-Kalender werden standardmäßig einmal pro Stunde aktualisiert.
# CALENDAR_SYNC_INTERVAL_MINUTES=60

# Terminerinnerungen werden standardmäßig alle 30 Sekunden geprüft.
# EVENT_REMINDER_INTERVAL_SECONDS=30

# Zusätzliche Ursprünge für die native App oder eine getrennt gehostete UI.
# Kommagetrennt und nur vertrauenswürdige Adressen eintragen.
# CORS_ALLOWED_ORIGINS=https://familie.example.de,http://192.168.178.50:3001

# Nur einschalten, wenn Kalenderlinks bewusst auf ein Gerät im eigenen
# Heimnetz zeigen, zum Beispiel auf einen lokalen Nextcloud-Server.
# CALENDAR_ALLOW_PRIVATE_HOSTS=true

# Optional: Agent-API aktivieren. Ohne Schlüssel bleibt sie gesperrt.
# AGENT_API_KEY=change-me-separate-random-api-key

# Optional: feste Web-Push-Schlüssel für mehrere Serverinstanzen.
# Ohne diese Werte erzeugt der Planer einmalig eigene Schlüssel und speichert
# sie verschlüsselt in der SQLite-Datenbank.
# VAPID_SUBJECT=mailto:family-planner@example.de
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
